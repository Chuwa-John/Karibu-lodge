{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      "tests/**",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "firestore.indexes.json",
      "*.md"
    ],
    "rewrites": [
      {
        "source": "/staff",
        "destination": "/staff.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9098
    },
    "firestore": {
      "port": 8081
    },
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": true,
      "port": 4401
    },
    "singleProjectMode": true
  }
}
